{
  "functions": [
    {
      "source": "funkcje",
      "codebase": "asystentka",
      "runtime": "nodejs22",
      "ignore": [
        "node_modules",
        "test.js"
      ]
    }
  ],
  "firestore": {
    "rules": "firestore.rules"
  },
  "hosting": {
    "site": "asystentka-kramm",
    "public": "asystentka",
    "ignore": [
      "README.md"
    ],
    "headers": [
      {
        "source": "**/*.@(html|js|webmanifest)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      }
    ]
  }
}
